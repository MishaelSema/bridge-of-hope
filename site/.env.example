# MongoDB — submissions from the contact / pledge form are stored here
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB=bridge-of-hope

# SMTP (Zoho) — notification email when a form is submitted
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=user@yourdomain.com
SMTP_PASS=change-me
SMTP_FROM=Your Name <user@yourdomain.com>
CONTACT_EMAIL=you@example.com

# Cloudinary — image storage once real photography arrives
# Either one CLOUDINARY_URL …
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# … or the three separate values:
# CLOUDINARY_CLOUD_NAME=change-me
# CLOUDINARY_API_KEY=change-me
# CLOUDINARY_API_SECRET=change-me
